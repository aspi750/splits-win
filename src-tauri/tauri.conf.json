{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splits Coach",
  "version": "0.1.2",
  "identifier": "com.aspi.splits-coach",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Splits Coach",
        "width": 1160,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/icon.png"
    ],
    "copyright": "© 2026 A750LABS. Based on Splits by Bytefabrika."
  }
}
