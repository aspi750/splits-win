{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splits Coach",
  "version": "0.1.2",
  "identifier": "com.aspi.splits-coach",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Splits Coach",
        "width": 1160,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 A750LABS. Based on Splits by Bytefabrika."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGNDQ3REM0QUM4MTE5NjgKUldSb0dZR3N4SDFFMzVyOWZmMDBJODk3NXE5ZWRoM0hvWk93Tnc2NStlQVVmWlpjV2lqSkNLTVgK",
      "endpoints": [
        "https://github.com/aspi750/splits-win/releases/latest/download/latest.json"
      ]
    }
  }
}
